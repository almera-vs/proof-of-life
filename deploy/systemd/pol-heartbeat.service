[Unit]
Description=Proof of Life PITR heartbeat
After=network-online.target
Wants=network-online.target

[Service]
User=pol
EnvironmentFile=/etc/pol/env
ExecStart=/usr/local/bin/pol fingerprint heartbeat -c /etc/pol/drill.yaml
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
